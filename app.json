{
  "expo": {
    "name": "Recomp — Muscle & Fat Loss",
    "slug": "recomp-workout",
    "scheme": ["recomp", "formworkout"],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router", "expo-notifications"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Recomp — Muscle & Fat Loss"
    },
    "android": {
      "package": "com.form.workout"
    },
    "ios": {
      "bundleIdentifier": "com.form.workout",
      "supportsTablet": true
    }
  }
}
