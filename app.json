{
  "expo": {
    "name": "Recomp",
    "slug": "recomp-workout",
    "scheme": [
      "recomp",
      "formworkout"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo.png",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#10120F"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Recomp",
      "favicon": "./assets/logo.png"
    },
    "android": {
      "package": "com.rajjitlaishram.recomp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#10120F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.rajjitlaishram.recomp",
      "supportsTablet": true
    }
  }
}
